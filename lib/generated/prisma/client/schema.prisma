generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model category {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  inventory inventory[]
}

model users {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime
  email     String   @unique
  name      String
  password  String
  role      String
  updatedAt DateTime
}

model inventory {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  make         String
  model        String
  year         Int
  price        Float
  mileage      Float
  fuelType     FuelType
  condition    Condition
  transmission Transmission
  images       Json
  status       Status
  description  String
  slug         String       @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  categoryId   String       @db.ObjectId
  category     category     @relation(fields: [categoryId], references: [id])
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum Condition {
  NEW
  USED
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum Status {
  AVAILABLE
  SOLD
  PENDING
  RESERVED
}
